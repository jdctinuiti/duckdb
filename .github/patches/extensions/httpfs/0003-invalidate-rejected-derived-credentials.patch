 	}
 }
 
+TEST_CASE("HTTPFS refresh is independent of the catalog snapshot", "[httpfs][s3][refresh][secret_snapshot]") {
+	for (const auto &client : {"httplib", "curl"}) {
+		for (bool older_snapshot : {false, true}) {
+			DYNAMIC_SECTION(client << ", older snapshot: " << older_snapshot) {
+				MockS3ServerConfig config;
+				config.auth.refresh_target = MockS3RefreshTarget::HEAD;
+				MockS3Server server(std::move(config));
+				DuckDB db(nullptr);
+				Connection outer(db);
+				Connection inner(db);
+				S3TestHelper::LoadExtension(db);
+				for (auto con : {&outer, &inner}) {
+					S3TestHelper::RequireQueryOk(*con,
+					                             StringUtil::Format("SET httpfs_client_implementation='%s'", client));
+					S3TestHelper::RequireQueryOk(*con, "SET enable_external_file_cache=false");
+					S3TestHelper::RequireQueryOk(*con, "SET http_retries=0");
+				}
+				S3TestHelper::RequireQueryOk(outer, StringUtil::Format(R"(
+CREATE SECRET refresh_s3 (
+    TYPE S3, KEY_ID 'STALE_KEY', SECRET 'STALE_SECRET', REGION 'us-east-1',
+    ENDPOINT '%s', URL_STYLE 'path', USE_SSL false,
+    REFRESH_INFO MAP {
+        'KEY_ID': 'FRESH_KEY', 'SECRET': 'FRESH_SECRET', 'REFRESH': 'auto'
+    }
+))",
+				                                                       server.Endpoint()));
+				S3TestHelper::RequireQueryOk(outer, "BEGIN");
+				S3TestHelper::RequireQueryOk(outer, "SELECT * FROM duckdb_secrets()");
+				if (older_snapshot) {
+					S3TestHelper::RequireQueryOk(inner, StringUtil::Format(R"(
+CREATE OR REPLACE SECRET refresh_s3 (
+    TYPE S3, KEY_ID 'FRESH_KEY', SECRET 'FRESH_SECRET', REGION 'us-east-1',
+    ENDPOINT '%s', URL_STYLE 'path', USE_SSL false
+))",
+					                                                       server.Endpoint()));
+				}
+				OpenForRead(outer, FileFlags::FILE_FLAGS_READ | FileFlags::FILE_FLAGS_DIRECT_IO);
+				S3TestHelper::RequireQueryOk(inner, "BEGIN");
+				OpenForRead(inner, FileFlags::FILE_FLAGS_READ | FileFlags::FILE_FLAGS_DIRECT_IO);
+				S3TestHelper::RequireQueryOk(inner, "COMMIT");
+				S3TestHelper::RequireQueryOk(outer, "ROLLBACK");
+				auto observations = server.Observations();
+				INFO(MockS3DescribeObservations(observations));
+				REQUIRE(S3TestHelper::CountObservations(observations, "HEAD", "STALE_KEY", 403) == 1);
+				REQUIRE(S3TestHelper::CountObservations(observations, "HEAD", "FRESH_KEY", 200) == 2);
+			}
+		}
+	}
+}
+
 } // namespace duckdb
